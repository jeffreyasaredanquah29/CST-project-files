clear;
disp(datetime)
clf;

%---------------- Assumptions & Definitions-----------
Z0 = 50; %Transmission line impedance
%Zs=   % source impedance
%Zin =   %Antenna Input impedance(this may not be predefined...the rest are)
%U0 =  % Isometric antenna radiation intensity constant
%J = % Current source equation
M = 0; % Magnetic current source equation
f= 2.4e6 ;% frequency input on VNA in GHz
w = 2*pi*f; % angular frequency
dia_const = 0.77; %Coax diaelectric constant
C = 300e6; % speed of light
C_d = 300e6 * dia_const; % speed of light through coax medium
wave_num = w/C_d; % wavenumber k present in greenes theorem solution for A
phi_max = 2*pi;
mu = 4*pi* 1e-7;
cA = 0.003; % cross sectional area of wire is 3mm
cond = 5.8e7; % Conductivity of copper(material of outer coax shield)


const= (1.25e-6)/(4*pi);
I_0 = 1; % Initial current input of VNA in amps
N = 1001; % Linspace iterations
PhiTheta_n = linspace(0,phi_max,N); % phi_n array from 0 to 360
a = 0.1; % Radius of loop Antenna in meters
l_circum= 2*pi*a;
dl = (2*pi*a)/N; % dl component of A integral
r = zeros(3,N); % loop is Assumed to be centered on origin. source cordinate is the origin
r_prime = [a*cos(PhiTheta_n);a*sin(PhiTheta_n);zeros(1,N)]; % this r' encompasses the entire circe
r_vec = r-r_prime;
r_mag = vecnorm(r_vec,2,1); % magnitude of distance
r_mag(r_mag== 0) = a; % conditional to avoid divided by 0 error
A_r = (I_0*PhiTheta_n).*(exp(-1i*wave_num*r_mag)/r_mag)* dl;
Cap = 0.3e-10;
int_imp = 377; %Intrinsic Impedance of free space






%-------------E and H derrivations for power density(use greens function solution)---------------
A_j = sum(A_r); % Current source contribution to Auxillary potential "A"
F_j = 0;  % Current source contribution to Auxillary potential "F"
A_m = 0; % Magnetic source contribution to Auxillary potential "A"
F_m = 0; % Magnetic source contribtion to Auxillary potential "F"

A_r = A_j + A_m;
F= F_j + F_m;
E = -1i*w*A_r; % Equation for Electric field
F = 0;

%-------------Radiated field Calculations---------------------------

%-------Radiated power------
r_far = 1; % radiation sphere radius
d_theta = phi_max/(2*N);
d_phi = phi_max/N;
phi_vec = linspace(0,phi_max,N);
theta_vec = linspace(0,phi_max/2,N);
[THETA,PHI] = meshgrid(theta_vec,phi_vec);
da = r_far^2*sin(THETA).*d_theta*d_phi;
P_rad = sum((vecnorm(E,2,1)^2/(2*int_imp)).*da,'all');



%------ Frequency Sweep for s11-----
N_freq = 1000000; %Number of frequency samples
freq_min = 1; % Minimum value for frequency sweep
freq_max = 1e9; % Maximum value for frequency sweep
f_vec = linspace(freq_min,freq_max,N_freq); % sweep from 1 to 3Ghz
L_loop = mu*(log(8*a/cA)- 2); % inductive contribution to reactance





s11_dB = zeros(1,N_freq); % These are empty vectors to store eventual values
R_rad = zeros(1,N_freq);
R_loss =  zeros(1,N_freq);
Reac = zeros(1,N_freq);


omega = 2*pi*f_vec; % This updates the angular frequency for each point on the sweep
sk_depth = sqrt((pi*mu*cond*f_vec).^-1); % Skin depth is how much the rf input penetrates the conductor its what causes R_loss to vary by frequency
k_0Vec = omega/C;
k_0 = k_0Vec; % updated wave number
R_radvec= 20*pi^2*(k_0*a).^4; % in order for to align k indexes these equations must be made into matrices earlier
R_rad = R_radvec; % R_rad is the key to unlocking s11 we do a frequency sweep on it to fully encompasses the entire s11 curve
R_lossvec = (a)./(cA*sk_depth*cond);
R_loss = R_lossvec; % equation for R_loss skin depth is the independent variable(technically IV is frequency though)
Reac_vec = 1i*L_loop*omega;
Reac = Reac_vec;  % equation for reactive component as a function of angular freq


% input impedance final calculation as a vector
Z_in = (R_rad + R_loss) + 1i*Z0*(tan(k_0*l_circum)/2)+ 1./(omega*Cap);





    ref_coe = (Z_in - Z0)./(Z_in + Z0); % Standard equation for voltage reflection coefficient used to get s11
    s11_dBVec= 20*log10(ref_coe);
    s11_dB = 20*log10(abs(ref_coe)); % Standard equation for s11

    y= 20*log10(abs(ref_coe));

dB_Cap = max(s11_dB);
Ref_coeMin = min(ref_coe);




%--------------------Models--------------------------

%-----s11 Smith chart plot-------
figure(1);
s = smithplot(f_vec, ref_coe, 'LineWidth', 3);
s.FontSize = 12;

