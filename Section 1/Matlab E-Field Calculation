cond = 5.8e7; % Conductivity of copper(material of outer coax shield)


const= (1.25e-6)/(4*pi);
I_0 = 1; % Initial current input of VNA in amps
N = 1001; % Linspace iterations
PhiTheta_n = linspace(0,phi_max,N); % phi_n array from 0 to 360
a = 0.1; % Radius of loop Antenna in meters
l_circum= 2*pi*a;
dl = (2*pi*a)/N; % dl component of A integral
r = zeros(3,N); % loop is Assumed to be centered on origin. source cordinate is the origin
r_prime = [a*cos(PhiTheta_n);a*sin(PhiTheta_n);zeros(1,N)]; % this r' encompasses the entire circe
r_vec = r-r_prime;
r_mag = vecnorm(r_vec,2,1); % magnitude of distance
r_mag(r_mag== 0) = a; % conditional to avoid divided by 0 error
A_r = (I_0*PhiTheta_n).*(exp(-1i*wave_num*r_mag)/r_mag)* dl;
Cap = 0.3e-10;
int_imp = 377; %Intrinsic Impedance of free space






%-------------E and H derrivations for power density(use greens function solution)---------------
