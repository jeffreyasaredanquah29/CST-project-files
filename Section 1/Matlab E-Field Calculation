M = 0; % Magnetic current source equation
f= 2.4e6 ;% frequency input on VNA in GHz
w = 2*pi*f; % angular frequency
dia_const = 0.77; %Coax diaelectric constant
C = 300e6; % speed of light
C_d = 300e6 * dia_const; % speed of light through coax medium
wave_num = w/C_d; % wavenumber k present in greenes theorem solution for A
phi_max = 2*pi;
mu = 4*pi* 1e-7;
